generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("AUXILIAR") // ADMIN | AUXILIAR
  isActive     Boolean   @default(true)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("usuarios")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sesiones")
}

model Contact {
  id              String           @id @default(uuid())
  phone           String           @unique
  name            String?
  documentId      String?
  documentType    String?
  birthDate       DateTime?
  email           String?
  residenceCity   String?
  residenceAddress String?
  hasActiveEps    Boolean?
  isInternational Boolean?         @default(false)
  userTypeId      String?
  userType        UserType?        @relation(fields: [userTypeId], references: [id], onDelete: SetNull)
  conversations   Conversation[]
  appointments    Appointment[]
  surgicalQuotes  SurgicalQuote[]
  supportTickets  SupportTicket[]
  npsSurveys      NpsSurvey[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([documentId])
  @@index([userTypeId])
  @@map("contactos")
}

model Conversation {
  id          String        @id @default(uuid())
  contactId   String
  contact     Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status      String        @default("BOT") // BOT | REQUIRES_AGENT | AGENT_TAKEN | CLOSED
  currentFlow String        @default("IDLE") // IDLE | F01_CONSULTA | F02_QUIRURGICO | F03_REFERIDO | F04_AUXILIAR | POST_CONSULTA | POST_QX | NPS_SURVEY
  currentStep String        @default("ROOT")
  flowData    Json          @default("{}")
  messages    Message[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([contactId])
  @@index([status, updatedAt])
  @@map("conversaciones")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String       // USER | BOT | AGENT | SYSTEM
  content        String
  mediaUrl       String?
  waMessageId    String?      @unique
  status         String       @default("sent") // sent | delivered | read | failed
  deliveryError String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("mensajes")
}

model IncomingMessageJob {
  id          String    @id @default(uuid())
  waMessageId String?   @unique
  phone       String
  senderName  String?
  sourceChannel String   @default("META")
  text        String    @db.Text
  status      String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, availableAt, createdAt])
  @@index([phone, status])
  @@map("cola_mensajes_entrantes")
}

model Appointment {
  id             String    @id @default(uuid())
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userTypeId     String?
  userType       UserType? @relation(fields: [userTypeId], references: [id], onDelete: SetNull)
  doctorId       String?
  doctor         Doctor?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  specialtyId    String?
  specialtyRef   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  locationId     String?
  location       Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  officeId       String?
  office         Office?   @relation(fields: [officeId], references: [id], onDelete: SetNull)
  specialty      String
  doctorName     String
  dateTime       DateTime
    durationMinutes Int      @default(30)
  isFirstTime    Boolean   @default(true)
  price          Decimal     @db.Decimal(12, 2)
  paymentStatus  String    @default("PENDING") // PENDING | PAID | PAY_AT_WINDOW
  paymentLink    String?
  isReferral     Boolean   @default(false)
  referralCode   String?
  referralModel  String?   // MODEL_A | MODEL_B
  status         String    @default("CONFIRMED") // CONFIRMED | CANCELLED | RESCHEDULED | ATTENDED
  createdAt      DateTime  @default(now())

  @@index([contactId, dateTime])
  @@index([status, dateTime])
  @@index([doctorId, dateTime])
  @@index([userTypeId])
  @@map("citas")
}

model SurgicalQuote {
  id                   String    @id @default(uuid())
  contactId            String
  contact              Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userTypeId           String?
  userType             UserType? @relation(fields: [userTypeId], references: [id], onDelete: SetNull)
  procedureDescription String
  hasMedicalOrder      Boolean
  hasActiveEps         Boolean   @default(false)
  medicalOrderFileUrl  String?
  status               String    @default("PENDING_AUXILIAR") // PENDING_AUXILIAR | QUOTED | APPROVED | SCHEDULED | CANCELLED
  cupsCode             String?
  quotedAmount         Decimal?  @db.Decimal(12, 2)
  createdAt            DateTime  @default(now())

  @@index([contactId, createdAt])
  @@index([status, createdAt])
  @@index([userTypeId])
  @@map("cotizaciones_quirurgicas")
}

model UserType {
  id             String          @id @default(uuid())
  code           String          @unique // PARTICULAR | EGRESADO_UNAL | COLABORADOR_HUN | OTRO
  name           String          // Paciente Particular | Egresado Universidad Nacional de Colombia | Colaborador HUN | Otro (Contactar con un asesor)
  description    String?
  active         Boolean         @default(true)
  contacts       Contact[]
  appointments   Appointment[]
  surgicalQuotes SurgicalQuote[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("tipos_usuario")
}

model SupportTicket {
  id          String    @id @default(uuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        String    // E001_WAITING_LIST | E002_TECH_ERROR | E003_FALLBACK | E004_OFF_HOURS | E005_INVALID_CODE | E009_PQRS | POST_QX_ALARM | MANUAL_AGENT
  priority    String    @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  description String
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([contactId, createdAt])
  @@index([priority, status, createdAt])
  @@map("tickets_soporte")
}

model NpsSurvey {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  hasPqrs   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
  @@map("encuestas_nps")
}

model Specialty {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  active       Boolean            @default(true)
  doctors      DoctorSpecialty[]
  appointments Appointment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("especialidades")
}

model Doctor {
  id             String             @id @default(uuid())
  fullName       String
  medicalLicense String?            @unique
  email          String?
  phone          String?
  active         Boolean            @default(true)
  specialties    DoctorSpecialty[]
  schedules      DoctorSchedule[]
  exceptions     ScheduleException[]
  appointments   Appointment[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([active, fullName])
  @@map("doctores")
}

model DoctorSpecialty {
  doctorId     String
  specialtyId  String
  doctor       Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([doctorId, specialtyId])
  @@map("doctores_especialidades")
}

model Location {
  id           String          @id @default(uuid())
  name         String
  address      String?
  active       Boolean         @default(true)
  offices      Office[]
  schedules    DoctorSchedule[]
  appointments Appointment[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("sedes")
}

model Office {
  id           String          @id @default(uuid())
  locationId   String
  name         String
  floor        String?
  active       Boolean         @default(true)
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  schedules    DoctorSchedule[]
  appointments Appointment[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([locationId, name])
  @@map("consultorios")
}

model DoctorSchedule {
  id             String    @id @default(uuid())
  doctorId       String
  locationId     String
  officeId       String?
  dayOfWeek      Int
  startTime      DateTime  @db.Time(0)
  endTime        DateTime  @db.Time(0)
  slotMinutes    Int       @default(30)
  validFrom      DateTime
  validUntil     DateTime?
  active         Boolean   @default(true)
  doctor         Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  location       Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  office         Office?   @relation(fields: [officeId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([doctorId, dayOfWeek, active])
  @@index([locationId, dayOfWeek, active])
  @@map("horarios_doctor")
}

model ScheduleException {
  id          String   @id @default(uuid())
  doctorId    String
  startsAt    DateTime
  endsAt      DateTime
  reason      String
  type        String   @default("BLOCKED")
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([doctorId, startsAt, endsAt])
  @@map("excepciones_agenda")
}

model AppointmentStatusHistory {
  id            String   @id @default(uuid())
  appointmentId String
  previousStatus String?
  newStatus     String
  changedBy     String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([appointmentId, createdAt])
  @@map("historial_estados_cita")
}

model MedicalAgenda {
  id               String   @id @default(uuid())
  specialtyCode    String?
  specialtyName    String
  doctorCode       String?
  doctorName       String
  officeCode       String?
  dayOfWeek        String
  startTime        String
  endTime          String
  frequencyMinutes Int      @default(20)
  modality         String?
  specifications   String?
  activity         String?  @default("CONSULTA")
  observations     String?
  scheduleType     String   @default("REGULAR") // REGULAR | ADICIONAL
  activeDates      String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([specialtyName])
  @@index([doctorName])
  @@index([dayOfWeek])
  @@index([scheduleType])
  @@map("agenda_medica")
}

model MedicalAbsence {
  id           String    @id @default(uuid())
  specialty    String?
  doctorName   String
  startDate    DateTime
  endDate      DateTime
  reason       String
  type         String    @default("NOVEDAD") // VACACIONES | NOVEDAD
  observations String?
  createdAt    DateTime  @default(now())

  @@index([doctorName, startDate, endDate])
  @@map("novedades_agenda")
}

model DiagnosticProcedure {
  id                 String   @id @default(uuid())
  packageId          String   @unique
  area               String
  name               String
  mainCups           String?
  mainCupsName       String?
  cupsCount          Int      @default(1)
  cupsList           String[]
  cupsDetails        String?  @db.Text
  durationMinutes    String?
  fasting            String?
  stopAnticoagulants String?
  venousAccess       String?
  patientPreparation String   @db.Text
  requiredSupplies   String?  @db.Text
  requiredLabs       String?  @db.Text
  labCups            String[]
  pathologyCups      String?
  requiresSedation   String?
  observations       String?  @db.Text
  sheetOrigin        String?
  sourceRow          Int?
  selector           String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  codes    DiagnosticProcedureCode[]
  supplies DiagnosticProcedureSupply[]

  @@index([packageId])
  @@index([area])
  @@index([mainCups])
  @@index([name])
  @@map("procedimientos_diagnosticos")
}

model DiagnosticProcedureCode {
  id            String              @id @default(uuid())
  procedureId   String
  procedure     DiagnosticProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  packageId     String
  order         Int                 @default(1)
  cups          String
  name          String
  suggestedRole String?
  sheetOrigin   String?
  sourceRow     Int?
  createdAt     DateTime            @default(now())

  @@index([procedureId])
  @@index([cups])
  @@index([packageId])
  @@map("codigos_procedimientos_diagnosticos")
}

model DiagnosticProcedureSupply {
  id          String              @id @default(uuid())
  procedureId String
  procedure   DiagnosticProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  packageId   String
  itemNumber  Int?
  supplyName  String              @db.Text
  quantity    String?
  condition   String?
  sheetOrigin String?
  createdAt   DateTime            @default(now())

  @@index([procedureId])
  @@index([packageId])
  @@map("insumos_procedimientos_diagnosticos")
}

model LaboratoryCatalog {
  id           String   @id @default(uuid())
  cups         String   @unique
  description  String
  group        String?
  usageNotes   String?  @db.Text
  packageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cups])
  @@index([group])
  @@map("catalogo_laboratorios")
}

model CupsTariff {
  id            String    @id @default(uuid())
  cups          String
  description   String    @db.Text
  category      String    // CONSULTA | TELEMEDICINA | REHABILITACION | IMAGENES_DX | LABORATORIO
  categoryLabel String
  particularFee Decimal   @db.Decimal(12, 2)
  hun2024Fee    Decimal?  @db.Decimal(12, 2)
  egresadosFee  Decimal?  @db.Decimal(12, 2)
  sourceFile    String?
  sourceSheet   String?
  sourceRow     Int?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([cups, category])
  @@index([cups])
  @@index([category])
  @@index([description])
  @@map("tarifas_cups")
}

