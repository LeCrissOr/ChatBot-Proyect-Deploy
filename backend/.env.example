PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hun_chatbot?schema=public"
DATABASE_CONNECTION_LIMIT=10
FRONTEND_URL="http://localhost:5173"

# Usuarios iniciales del panel (cámbialos en entornos compartidos)
AUTH_SESSION_HOURS=8
AUTH_ADMIN_EMAIL="admin@hun.local"
AUTH_ADMIN_PASSWORD="Admin123!"
AUTH_AUXILIAR_EMAIL="auxiliar@hun.local"
AUTH_AUXILIAR_PASSWORD="Auxiliar123!"

# Meta WhatsApp Business Cloud API
WHATSAPP_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="1234567890"
WHATSAPP_VERIFY_TOKEN="genera-un-token-largo-y-unico"
WHATSAPP_APP_SECRET="secreto-de-la-aplicacion-meta"
WHATSAPP_API_VERSION="v20.0"

# Tiempos de inactividad (milisegundos)
INACTIVITY_WARNING_MS=600000
INACTIVITY_CLOSE_MS=120000
