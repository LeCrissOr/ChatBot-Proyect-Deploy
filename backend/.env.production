PORT=3001
NODE_ENV=production

# Base de Datos PostgreSQL en el Servidor Windows (Sesiones, Contactos, Historial de Chat y Tickets)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hun_chatbot?schema=public"
DATABASE_CONNECTION_LIMIT=10

# URLs del Servidor (El Dashboard compilado se sirve automaticamente en el mismo puerto 3001)
FRONTEND_URL="http://huncontigoparticulares.hun.edu.co:3001"
BACKEND_URL="http://huncontigoparticulares.hun.edu.co:3001"

# Usuarios del Dashboard Clinico (Cambiar contrasenas en el servidor final)
AUTH_SESSION_HOURS=8
AUTH_ADMIN_EMAIL="admin@hun.local"
AUTH_ADMIN_PASSWORD="Admin123!"
AUTH_AUXILIAR_EMAIL="auxiliar@hun.local"
AUTH_AUXILIAR_PASSWORD="Auxiliar123!"

# Integracion Directa por Endpoints Hosvital / HUN (100% Endpoints - Sin archivos Excel)
HOSVITAL_ENABLED=true
HUN_API_URL="http://190.109.10.204"
HUN_API_KEY="HospitalUniversitarioNacionaldeColombia"
HUN_API_TIMEOUT_MS=8000
HUN_DEFAULT_EPS="HUN25"

# Rutas de Endpoints HUN / Hosvital
HUN_ENDPOINT_ESPECIALIDADES="/webServiceEspecialidad/especialidades"
HUN_ENDPOINT_AGENDA="/webServiceAgenda/agenda"
HUN_ENDPOINT_CITAS_DOC="/webServiceCitaDocumento/consultar_citas_documento"
HUN_ENDPOINT_CITA_NUM="/webServiceCitaNumero/consultar_citas_numero"
HUN_ENDPOINT_ASIGNAR_CITA="/webServiceCita/api/asignar_cita"
HUN_ENDPOINT_CANCELAR_CITA="/webServiceCancelarCitaH/cancelar_cita"
HUN_ENDPOINT_VERIFICAR_CANCELACION="/webServiceCancelarCitaH/verificar_cancelacion"
HUN_ENDPOINT_TARIFAS="/webServiceTarifas/tarifas"
HUN_ENDPOINT_PREPARACIONES="/webServicePreparaciones/preparaciones"

# Meta WhatsApp Business Cloud API (Opcional si se usa conexion QR Baileys)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="hun-production-verify-token-2026"
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v20.0"

# Tiempos de inactividad (10 min aviso + 2 min cierre)
INACTIVITY_WARNING_MS=600000
INACTIVITY_CLOSE_MS=120000
